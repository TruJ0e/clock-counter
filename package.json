{
  "name": "clock-counter",
  "version": "0.3.0",
  "description": "A compact retro visual countdown timer that makes the passage of time easy to understand.",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test:e2e": "node tests/electron-e2e.mjs",
    "icon:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "verify": "npm test && npm run test:e2e",
    "test:packaged": "node tests/packaged-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "com.trujoe.clockcounter",
    "compression": "normal",
    "productName": "CLOCK COUNTER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "TruJ0e"
}
