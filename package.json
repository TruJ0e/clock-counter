{
  "name": "clock-counter",
  "version": "0.6.0",
  "description": "TruTimeClock with scheduled starts, independent visual timers, presets, and weekly desktop updates.",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "test:e2e": "node tests/electron-e2e.mjs",
    "icon:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "verify": "npm test && npm run test:e2e && npm run test:focus && npm run test:drawer && npm run test:advanced && npm run test:files && npm run test:schedule && npm run test:update-ui && npm run test:web-lite && npm run test:ttc",
    "test:packaged": "node tests/packaged-smoke.mjs",
    "test:focus": "node tests/focus-ui.mjs",
    "test:drawer": "node tests/drawer-ui.mjs",
    "test:advanced": "node tests/advanced-ui.mjs",
    "test:files": "node tests/file-operations.mjs",
    "build:web-lite": "node scripts/build-web-lite.cjs",
    "test:web-lite": "npm run build:web-lite && node tests/web-lite.mjs",
    "build:ttc": "node scripts/build-ttc-site.cjs",
    "test:ttc": "npm run build:ttc && node tests/ttc-site.mjs",
    "audit:public": "node scripts/audit-public.cjs",
    "test:ttc:live": "node tests/ttc-live.mjs",
    "build:release": "electron-builder --win nsis --publish never",
    "test:updates": "node --test tests/update-manager.test.js",
    "test:update-ui": "node tests/update-ui.mjs",
    "test:schedule": "node tests/scheduled-start-ui.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "com.trujoe.clockcounter",
    "compression": "maximum",
    "productName": "CLOCK COUNTER",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "package.json",
      "assets/**/*",
      "detached.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TruTimeClock-Setup-${version}.${ext}",
      "perMachine": false
    },
    "afterPack": "./scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "TruJ0e",
        "repo": "clock-counter",
        "releaseType": "release"
      }
    ]
  },
  "author": "TruJ0e",
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
